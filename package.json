{
  "name": "obsidian-md2wechat",
  "version": "1.3.3",
  "description": "Render Obsidian markdown to beautiful WeChat format and sync to WeChat Official Account with one click.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npx tsc -noEmit && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "wechat",
    "markdown"
  ],
  "author": "Zhuanz1",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "builtin-modules": "^3.2.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.5",
    "obsidian": "^1.1.1",
    "typescript": "^6.0.3"
  }
}
