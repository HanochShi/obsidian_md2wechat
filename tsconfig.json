{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "commonjs",
    "target": "ES2020",
    "allowJs": true,
    "strict": true,
    "lib": ["DOM", "ES2020"],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
